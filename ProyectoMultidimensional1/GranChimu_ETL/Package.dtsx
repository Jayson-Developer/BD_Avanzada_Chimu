            <component
              refId="Package\Carga FactAtenciones\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT a.AtencionID AS AtencionID_Origen, CONVERT(INT, CONVERT(CHAR(8), a.FechaAtencion, 112)) AS FechaKey, ISNULL(dp.PacienteKey, -1) AS PacienteKey, ISNULL(ds.ServicioKey, -1) AS ServicioKey, ISNULL(dpr.ProfesionalKey, -1) AS ProfesionalKey, ISNULL(dt.TipoAtencionKey, -1) AS TipoAtencionKey, ISNULL(dsec.SectorKey, -1) AS SectorKey, ISNULL(dseg.SeguroKey, -1) AS SeguroKey, ISNULL(dg.GrupoEtarioKey, -1) AS GrupoEtarioKey, CAST(CASE WHEN a.HoraInicio &lt; CAST('14:00' AS TIME) THEN 1 ELSE 2 END AS TINYINT) AS TurnoKey, a.HoraInicio, a.EdadAnios AS EdadAlAtender, CAST(1 AS INT) AS CantidadAtenciones, CAST(CASE WHEN a.CitaID IS NULL THEN 0 ELSE 1 END AS INT) AS AtencionesConCita, a.TiempoEsperaMin, a.DuracionMin FROM dbo.Atenciones AS a JOIN dbo.Pacientes AS pac ON pac.DNI = a.DNI LEFT JOIN dbo.DimGrupoEtario AS ge ON a.EdadAnios BETWEEN ge.EdadMinima AND ge.EdadMaxima LEFT JOIN BI_GranChimu_DW.dbo.DimPaciente AS dp ON dp.CodigoPaciente = pac.CodigoPaciente LEFT JOIN BI_GranChimu_DW.dbo.DimServicio AS ds ON ds.ServicioID_Origen = a.ServicioID LEFT JOIN BI_GranChimu_DW.dbo.DimProfesional AS dpr ON dpr.ProfesionalID_Origen = a.ProfesionalID LEFT JOIN BI_GranChimu_DW.dbo.DimTipoAtencion AS dt ON dt.TipoAtencionID_Origen = a.TipoAtencionID LEFT JOIN BI_GranChimu_DW.dbo.DimSector AS dsec ON dsec.SectorID_Origen = pac.SectorID LEFT JOIN BI_GranChimu_DW.dbo.DimSeguro AS dseg ON dseg.SeguroID_Origen = pac.SeguroID LEFT JOIN BI_GranChimu_DW.dbo.DimGrupoEtario AS dg ON dg.GrupoEtarioID_Origen = ge.GrupoEtarioID ORDER BY a.AtencionID;</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
