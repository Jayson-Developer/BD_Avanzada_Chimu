                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT p.CodigoPaciente, p.Sexo, p.FechaNacimiento, CAST(b.EdadAlCierre AS TINYINT) AS EdadAlCierre, g.NombreGrupo AS GrupoEtario, g.EtapaVida, p.SectorResidencia AS NombreSector, p.TipoSeguro AS NombreSeguro, p.FechaRegistro, CAST(LEFT(CONVERT(CHAR(10), p.FechaRegistro, 23), 7) AS CHAR(7)) AS AnioMesRegistro FROM dbo.Pacientes AS p JOIN dbo.vw_PacientesBI AS b ON b.DNI = p.DNI JOIN dbo.DimGrupoEtario AS g ON b.EdadAlCierre BETWEEN g.EdadMinima AND g.EdadMaxima ORDER BY p.CodigoPaciente;</property>
