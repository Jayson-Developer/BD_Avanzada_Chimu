                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT fa.AtencionKey, d.Orden, fa.FechaKey, fa.PacienteKey, fa.ServicioKey, ISNULL(dd.DiagnosticoKey, -1) AS DiagnosticoKey, td.TipoDxKey, fa.GrupoEtarioKey, fa.SectorKey, CAST(1 AS INT) AS CantidadDiagnosticos, CAST(CASE WHEN d.Orden = 1 THEN 1 ELSE 0 END AS INT) AS DiagnosticosPrincipales FROM dbo.DiagnosticosAtencion AS d JOIN BI_GranChimu_DW.dbo.FactAtenciones AS fa ON fa.AtencionID_Origen = d.AtencionID JOIN BI_GranChimu_DW.dbo.DimTipoDiagnostico AS td ON td.CodigoTipo = d.TipoDx LEFT JOIN BI_GranChimu_DW.dbo.DimDiagnostico AS dd ON dd.DiagnosticoID_Origen = d.DiagnosticoID ORDER BY d.AtencionID, d.Orden;</property>
