            <component
              refId="Package\Carga FactCitas\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT c.CitaID AS CitaID_Origen, CONVERT(INT, CONVERT(CHAR(8), c.FechaProgramada, 112)) AS FechaProgramadaKey, CONVERT(INT, CONVERT(CHAR(8), c.FechaRegistroCita, 112)) AS FechaRegistroKey, ISNULL(dp.PacienteKey, -1) AS PacienteKey, ISNULL(ds.ServicioKey, -1) AS ServicioKey, ISNULL(dpr.ProfesionalKey, -1) AS ProfesionalKey, ISNULL(de.EstadoCitaKey, -1) AS EstadoCitaKey, ISNULL(dm.MotivoCitaKey, -1) AS MotivoCitaKey, dr.RecordatorioKey, ISNULL(dsec.SectorKey, -1) AS SectorKey, ISNULL(dseg.SeguroKey, -1) AS SeguroKey, ISNULL(dg.GrupoEtarioKey, -1) AS GrupoEtarioKey, c.NumeroCita, c.CitaAnteriorID AS CitaAnteriorID_Origen, CAST(1 AS INT) AS CantidadCitas, CAST(CASE WHEN c.EstadoCitaID = 2 THEN 1 ELSE 0 END AS INT) AS Asistidas, CAST(CASE WHEN c.EstadoCitaID = 3 THEN 1 ELSE 0 END AS INT) AS Inasistencias, CAST(CASE WHEN c.EstadoCitaID = 4 THEN 1 ELSE 0 END AS INT) AS Reprogramadas, CAST(CASE WHEN c.EstadoCitaID = 5 THEN 1 ELSE 0 END AS INT) AS Canceladas, CAST(CASE WHEN c.NumeroCita = 2 THEN 1 ELSE 0 END AS INT) AS EsSegundaCita, DATEDIFF(DAY, c.FechaRegistroCita, c.FechaProgramada) AS DiasAnticipacion FROM dbo.Citas AS c JOIN dbo.Pacientes AS pac ON pac.DNI = c.DNI CROSS APPLY (SELECT DATEDIFF(YEAR, pac.FechaNacimiento, c.FechaProgramada) - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, pac.FechaNacimiento, c.FechaProgramada), pac.FechaNacimiento) &gt; c.FechaProgramada THEN 1 ELSE 0 END AS Edad) AS x LEFT JOIN dbo.DimGrupoEtario AS ge ON x.Edad BETWEEN ge.EdadMinima AND ge.EdadMaxima JOIN BI_GranChimu_DW.dbo.DimRecordatorio AS dr ON dr.NombreMedio = ISNULL(CAST(c.MedioRecordatorio AS NVARCHAR(30)), N'Sin recordatorio') LEFT JOIN BI_GranChimu_DW.dbo.DimPaciente AS dp ON dp.CodigoPaciente = pac.CodigoPaciente LEFT JOIN BI_GranChimu_DW.dbo.DimServicio AS ds ON ds.ServicioID_Origen = c.ServicioID LEFT JOIN BI_GranChimu_DW.dbo.DimProfesional AS dpr ON dpr.ProfesionalID_Origen = c.ProfesionalID LEFT JOIN BI_GranChimu_DW.dbo.DimEstadoCita AS de ON de.EstadoCitaID_Origen = c.EstadoCitaID LEFT JOIN BI_GranChimu_DW.dbo.DimMotivoCita AS dm ON dm.NombreMotivo = c.MotivoCita LEFT JOIN BI_GranChimu_DW.dbo.DimSector AS dsec ON dsec.SectorID_Origen = pac.SectorID LEFT JOIN BI_GranChimu_DW.dbo.DimSeguro AS dseg ON dseg.SeguroID_Origen = pac.SeguroID LEFT JOIN BI_GranChimu_DW.dbo.DimGrupoEtario AS dg ON dg.GrupoEtarioID_Origen = ge.GrupoEtarioID ORDER BY c.CitaID;</property>
                <property
