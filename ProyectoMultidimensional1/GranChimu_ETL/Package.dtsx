    <DTS:Executable
      DTS:refId="Package\Registrar resumen de carga"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{45E99D37-683B-437B-AED7-4E770F206F9D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Registrar resumen de carga"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DFEAC4B9-2D0A-45F1-B25E-ECA5D5FADAB0}"
          SQLTask:SqlStatementSource="INSERT INTO etl.LogCarga (Proceso, FilasLeidas, FilasInsertadas, FilasRechazadas, Estado, Mensaje) SELECT x.Proceso, x.FilasOrigen, x.FilasDW, x.FilasOrigen - x.FilasDW, CASE WHEN x.FilasOrigen = x.FilasDW THEN N'OK' ELSE N'ERROR' END, CASE WHEN x.FilasOrigen = x.FilasDW THEN N'Carga completa' ELSE N'Hay filas del origen que no llegaron al DW' END FROM (SELECT N'Carga DimFecha' AS Proceso, (SELECT COUNT(*) FROM BI_GranChimu.dbo.DimFecha) AS FilasOrigen, (SELECT COUNT(*) FROM dbo.DimFecha) AS FilasDW UNION ALL SELECT N'Carga DimSector', (SELECT COUNT(*) FROM BI_GranChimu.dbo.DimSector), (SELECT COUNT(*) FROM dbo.DimSector WHERE SectorKey &gt; 0) UNION ALL SELECT N'Carga DimSeguro', (SELECT COUNT(*) FROM BI_GranChimu.dbo.DimSeguro), (SELECT COUNT(*) FROM dbo.DimSeguro WHERE SeguroKey &gt; 0) UNION ALL SELECT N'Carga DimServicio', (SELECT COUNT(*) FROM BI_GranChimu.dbo.DimServicio), (SELECT COUNT(*) FROM dbo.DimServicio WHERE ServicioKey &gt; 0) UNION ALL SELECT N'Carga DimTipoAtencion', (SELECT COUNT(*) FROM BI_GranChimu.dbo.DimTipoAtencion), (SELECT COUNT(*) FROM dbo.DimTipoAtencion WHERE TipoAtencionKey &gt; 0) UNION ALL SELECT N'Carga DimEstadoCita', (SELECT COUNT(*) FROM BI_GranChimu.dbo.DimEstadoCita), (SELECT COUNT(*) FROM dbo.DimEstadoCita WHERE EstadoCitaKey &gt; 0) UNION ALL SELECT N'Carga DimGrupoEtario', (SELECT COUNT(*) FROM BI_GranChimu.dbo.DimGrupoEtario), (SELECT COUNT(*) FROM dbo.DimGrupoEtario WHERE GrupoEtarioKey &gt; 0) UNION ALL SELECT N'Carga DimDiagnostico', (SELECT COUNT(*) FROM BI_GranChimu.dbo.DimDiagnostico), (SELECT COUNT(*) FROM dbo.DimDiagnostico WHERE DiagnosticoKey &gt; 0) UNION ALL SELECT N'Carga DimMotivoCita', (SELECT COUNT(DISTINCT MotivoCita) FROM BI_GranChimu.dbo.Citas), (SELECT COUNT(*) FROM dbo.DimMotivoCita WHERE MotivoCitaKey &gt; 0) UNION ALL SELECT N'Carga DimProfesional', (SELECT COUNT(*) FROM BI_GranChimu.dbo.DimProfesional), (SELECT COUNT(*) FROM dbo.DimProfesional WHERE ProfesionalKey &gt; 0) UNION ALL SELECT N'Carga DimPaciente', (SELECT COUNT(*) FROM BI_GranChimu.dbo.Pacientes), (SELECT COUNT(*) FROM dbo.DimPaciente WHERE PacienteKey &gt; 0) UNION ALL SELECT N'Carga FactAtenciones', (SELECT COUNT(*) FROM BI_GranChimu.dbo.Atenciones), (SELECT COUNT(*) FROM dbo.FactAtenciones) UNION ALL SELECT N'Carga FactDiagnosticos', (SELECT COUNT(*) FROM BI_GranChimu.dbo.DiagnosticosAtencion), (SELECT COUNT(*) FROM dbo.FactDiagnosticos) UNION ALL SELECT N'Carga FactCitas', (SELECT COUNT(*) FROM BI_GranChimu.dbo.Citas), (SELECT COUNT(*) FROM dbo.FactCitas)) AS x;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
